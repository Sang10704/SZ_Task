<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_project_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@drawable/widget_bg_item"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Row 1: Dept Tag + Project Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_project_dept"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_badge_purple"
            android:paddingStart="4dp"
            android:paddingTop="1dp"
            android:paddingEnd="4dp"
            android:paddingBottom="1dp"
            android:text="Tech"
            android:textColor="#E0E7FF"
            android:textSize="8sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_project_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Seazen HR Portal desktop app"
            android:textColor="#F8FAFC"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_project_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="85%"
            android:textColor="#818CF8"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Row 2: Horizontal Progress Bar -->
    <ProgressBar
        android:id="@+id/widget_project_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginTop="5dp"
        android:max="100"
        android:progress="50"
        android:progressDrawable="@drawable/widget_progress_drawable" />

    <!-- Row 3: Responsible person & Task status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_project_person"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Phụ trách: Nguyễn Huỳnh Văn Sang"
            android:textColor="#94A3B8"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/widget_project_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Đang làm"
            android:textColor="#64748B"
            android:textSize="9sp" />
    </LinearLayout>
</LinearLayout>
